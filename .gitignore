# ------------------------------------
# 1. Dependencies
# ------------------------------------
# Node packages (The largest directory and most important to ignore)
**/node_modules/

# ------------------------------------
# 2. Build & Compilation Output
# ------------------------------------
# General build outputs
/dist
/build
/out
/coverage

# Common framework-specific build outputs
.parcel-cache
.nuxt
.next
/temp

# ------------------------------------
# 3. Local Environment & Config
# ------------------------------------
# Environment variables and secrets
.env.*.local
.DS_STORE

# Logs and debug files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Yarn PnP files
.pnp.*

# ------------------------------------
# 4. Editor and OS Files
# ------------------------------------
# OS generated files
.DS_Store
Thumbs.db

# Editor directories and files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
config.bat
